function normalizeProjectRecord(p){
  const x={...p};
  // PAIMANA April-2026 records use the official field names startDate /
  // targetCompletion / revisedCompletion / revisedCost. The UI uses a shorter
  // common schema, so normalize once here instead of showing 'Not available'.
  if(x.start==null||x.start==='') x.start=x.startDate||null;
  if(x.targetCompletion==null||x.targetCompletion==='') x.targetCompletion=x.targetCompletion||null;
  if(x.completion==null||x.completion==='') x.completion=x.revisedCompletion||x.targetCompletion||null;
  if(x.cost==null||x.cost==='') x.cost=x.revisedCost??x.originalCost??null;
  if(x.originalCost==null||x.originalCost==='') x.originalCost=x.approvedCost??null;
  if(x.expenditure==null||x.expenditure==='') x.expenditure=x.cumulativeExpenditure??null;
  if(x.financialProgress==null && Number.isFinite(Number(x.expenditure)) && Number(x.cost)>0){
    x.financialProgress=Math.max(0,Math.min(100,Math.round(Number(x.expenditure)/Number(x.cost)*1000)/10));
  }
  if(x.progress==null && x.physicalProgress!=null) x.progress=Number(x.physicalProgress);
  if(x.status==null||x.status==='') x.status='Ongoing';
  return x;
}
