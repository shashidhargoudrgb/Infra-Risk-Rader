:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#12345b;background:#f6f9fd;font-synthesis:none}
*{box-sizing:border-box}body{margin:0;background:#f6f9fd}button,input,select,textarea{font:inherit}button{cursor:pointer}
.app{display:flex;min-height:100vh}.sidebar{width:235px;background:#063566;color:white;position:fixed;left:0;top:0;bottom:0;padding:18px 12px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;align-items:center;gap:10px;font-weight:800;padding:8px 10px 22px;font-size:15px}.brand-mark{width:28px;height:28px;border-radius:8px;background:#fff;color:#086bdc;display:grid;place-items:center}.sidebar nav{display:flex;flex-direction:column;gap:5px}.sidebar nav a{color:#dcecff;text-decoration:none;padding:12px 12px;border-radius:8px;display:flex;align-items:center;gap:11px;font-size:13px}.sidebar nav a.active,.sidebar nav a:hover{background:#0b78e6;color:#fff}.nav-icon{width:18px;text-align:center}.admin{margin-top:auto;padding:15px 10px;border-top:1px solid rgba(255,255,255,.14);font-size:13px}.main{margin-left:235px;width:calc(100% - 235px)}.topbar{height:65px;background:#fff;border-bottom:1px solid #e3ebf5;display:flex;justify-content:flex-end;align-items:center;padding:0 28px;gap:12px}.mobile-title{display:none;margin-right:auto;font-weight:800}.date-pill{border:1px solid #dce5f0;padding:8px 15px;border-radius:10px;font-size:12px;font-weight:700}.icon-btn{border:0;background:none;font-size:20px}.content{padding:26px;max-width:1400px;margin:auto}.page-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.page-title h1{margin:0;font-size:24px;color:#0a3769}.page-title p{margin:5px 0;color:#71849c}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:16px}.stat{background:#fff;border:1px solid #e1eaf4;border-radius:12px;padding:16px;display:flex;align-items:center;gap:14px;box-shadow:0 2px 7px rgba(19,65,110,.03)}.stat-icon{width:43px;height:43px;border-radius:11px;display:grid;place-items:center;font-size:20px;background:#e9f2ff;color:#1971e5}.stat.high .stat-icon{background:#fff0f1;color:#ef3340}.stat.medium .stat-icon{background:#fff7e6;color:#e8a000}.stat.low .stat-icon{background:#eafaf2;color:#16a765}.stat small{display:block;color:#71849c;font-size:12px}.stat strong{display:block;font-size:22px;margin-top:4px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}.card{background:#fff;border:1px solid #e1eaf4;border-radius:12px;padding:18px;box-shadow:0 2px 7px rgba(19,65,110,.03)}.card h3{margin:0 0 14px;font-size:16px;color:#143e6d}.card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.card-head h3{margin:0}.card-head a{color:#0b73df;text-decoration:none;font-size:12px;font-weight:700}.muted{font-size:11px;color:#7a8da4}.donut-row{display:flex;align-items:center;justify-content:center;gap:25px}.donut{position:relative;width:210px;height:210px}.donut-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.donut-label b{font-size:21px}.donut-label span{font-size:11px;color:#72849b}.risk-list{display:flex;flex-direction:column;gap:15px;font-size:12px}.risk-list div{display:grid;grid-template-columns:14px 1fr auto;gap:8px;align-items:center}.dot{display:inline-block;width:10px;height:10px;border-radius:50%}.dot.high,.alert-dot.high{background:#ef3340}.dot.medium,.alert-dot.medium{background:#f4a300}.dot.low,.alert-dot.low{background:#16a765}.dot.blue{background:#2478e8}.alert-row{display:grid;grid-template-columns:22px 1fr auto;gap:10px;align-items:start;padding:12px 0;border-top:1px solid #edf2f7}.alert-row:first-of-type{border-top:0}.alert-row p{margin:4px 0 0;color:#647890;font-size:12px}.alert-row small{color:#8a9ab0;font-size:10px}.alert-dot{width:22px;height:22px;border-radius:50%;color:#fff;display:grid;place-items:center;font-weight:800;font-size:12px}.map-card{background:#fff;border:1px solid #e1eaf4;border-radius:12px;padding:14px;min-width:0}.map-wrap{height:305px;border-radius:10px;overflow:hidden;margin-top:10px}.legend{display:flex;gap:22px;padding-top:10px;font-size:11px;color:#60758e}.legend span{display:flex;gap:7px;align-items:center}.toolbar{display:flex;gap:10px;align-items:center;margin-bottom:15px}.toolbar input{flex:1;min-width:180px}.toolbar select{min-width:135px}.toolbar.right{justify-content:flex-end}.toolbar input,.toolbar select,.form-grid input,.form-grid select,.form-grid textarea,.chat-input input{border:1px solid #d9e4f0;background:#fff;border-radius:8px;padding:11px 12px;color:#254568;outline:none}.toolbar input:focus,.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus,.chat-input input:focus{border-color:#267ce6;box-shadow:0 0 0 3px rgba(38,124,230,.08)}.primary{border:0;background:#1476e4;color:#fff;border-radius:8px;padding:10px 17px;font-weight:700}.ghost{border:1px solid #d7e3ef;background:#fff;color:#264c72;border-radius:8px;padding:9px 14px;font-weight:650}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:850px}th,td{text-align:left;padding:14px 9px;border-bottom:1px solid #edf2f7;font-size:12px}th{color:#4f6985;font-size:11px;background:#fbfdff}td{color:#294a6d}.badge{display:inline-flex;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:800}.badge.high,.badge.High{background:#ffe7ea;color:#e32839}.badge.medium,.badge.Medium{background:#fff1d3;color:#cf8a00}.badge.low,.badge.Low{background:#e7f8ef;color:#109258}.progress-pill{background:#e7f8f7;color:#119b91;padding:5px 10px;border-radius:999px;font-weight:800}.view-btn{border:1px solid #2581eb;color:#1370d6;border-radius:8px;padding:6px 11px;text-decoration:none;font-weight:700}.pagination{display:flex;align-items:center;gap:7px;justify-content:flex-end;padding-top:15px}.pagination button{width:29px;height:29px;border:1px solid #dbe5ef;background:#fff;border-radius:6px}.pagination button.selected{background:#1476e4;color:#fff;border-color:#1476e4}.pagination span{margin-left:auto;color:#72849a;font-size:11px}.breadcrumb{color:#67819c;font-size:12px;margin-bottom:15px}.breadcrumb a{color:#0b70d8;text-decoration:none}.project-head{display:flex;align-items:center;gap:13px;margin-bottom:18px}.project-head h1{font-size:22px;margin:0 0 8px}.project-head>.badge{margin-left:auto;font-size:13px;padding:8px 12px}.avatar{width:42px;height:42px;border-radius:50%;background:#dfeeff;color:#1476e4;display:grid;place-items:center}.chips{display:flex;gap:8px}.chips span{border:1px solid #bcd6f3;border-radius:999px;padding:5px 10px;font-size:10px;color:#1468bf}.tabs{display:flex;gap:5px;border-bottom:1px solid #e2eaf2;margin-bottom:16px}.tabs button{border:0;background:none;padding:11px 18px;color:#526b86;font-size:12px}.tabs button.active{color:#0b70d8;border-bottom:2px solid #1476e4;font-weight:800}.tabs.pills{border:0;gap:10px}.tabs.pills button{border:1px solid #e0e8f1;border-radius:20px}.tabs.pills button.active{background:#eaf3ff;border-color:#bcd8fa;border-bottom:1px solid #bcd8fa}.card dl{display:grid;grid-template-columns:1fr 1fr;gap:14px 8px;margin:0}.card dt{font-size:11px;color:#71859c}.card dd{margin:0;font-size:12px;font-weight:700}.card dd em{color:#e62d3d;font-style:normal}.danger{color:#ef3340}.progress-circles{display:flex;justify-content:space-around}.circle{width:130px;height:130px;border-radius:50%;border:12px solid #d9eef2;display:flex;flex-direction:column;align-items:center;justify-content:center}.circle b{font-size:22px}.circle span{font-size:11px;color:#6f849d}.risk-score{text-align:center;padding:12px}.risk-score div{font-size:52px;font-weight:800;color:#ef3340}.risk-score small{font-size:15px;color:#7a8da4}.risk-score span{display:block;color:#ef3340;font-weight:800}.prediction{display:flex;justify-content:space-between;border-top:1px solid #edf2f7;padding:14px 0;font-size:12px}.prediction b{color:#ef3340}.big-progress{display:grid;grid-template-columns:170px 1fr 55px;align-items:center;gap:15px;margin:22px 0;font-size:12px}.big-progress>div{height:12px;background:#edf3f8;border-radius:20px;overflow:hidden}.big-progress i{height:100%;display:block;background:#1476e4;border-radius:20px}.timeline-item{display:flex;gap:15px;padding:14px 0;border-bottom:1px solid #edf2f7}.timeline-item p{margin:4px 0;color:#71859c;font-size:11px}.timeline-dot{width:14px;height:14px;border-radius:50%;margin-top:2px;background:#f4a300}.timeline-dot.done{background:#16a765}.timeline-dot.delayed{background:#ef3340}.conflict{display:flex;align-items:center;gap:12px;border-top:1px solid #edf2f7;padding:14px 0}.conflict b{font-size:12px;flex:1}.dependency-card{min-height:600px}.graph{height:480px;position:relative;overflow:hidden;background:radial-gradient(circle,#f5f9fd 1px,transparent 1px);background-size:20px 20px;border:1px dashed #dbe6f1;border-radius:12px}.core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:170px;height:100px;border-radius:50%;background:#0755a0;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;z-index:3;box-shadow:0 8px 25px rgba(6,85,160,.2)}.core b{font-size:13px;margin-top:5px}.connector{position:absolute;height:2px;background:#8bb4e6;transform-origin:left center;z-index:1}.node{position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:9px;background:#fff;border:1px solid #dce7f2;border-radius:10px;padding:10px 13px;min-width:150px;box-shadow:0 4px 12px rgba(30,70,110,.06);z-index:4}.node span{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;color:#fff;background:#2478e8}.node.done span{background:#16a765}.node.pending span{background:#f4a300}.node.delayed span{background:#ef3340}.node b{font-size:11px}.big-alert{display:flex;align-items:center;gap:16px;padding:19px 0;border-bottom:1px solid #edf2f7}.big-alert:last-child{border-bottom:0}.big-alert .alert-main{flex:1}.big-alert h3{margin:6px 0 3px;font-size:13px}.big-alert p{margin:0;color:#667d96;font-size:12px}.big-alert time{font-size:11px;color:#8091a7;white-space:nowrap}.big-alert.ack{opacity:.55}.report-placeholder{padding:60px;text-align:center;color:#70849b}.report-placeholder b{display:block;color:#173f6c;font-size:18px;margin-bottom:8px}.wizard{max-width:1000px;margin:auto}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:28px}.steps>div{position:relative;display:flex;align-items:center;gap:9px;color:#8193a8;font-size:12px}.steps>div:not(:last-child):after{content:"";position:absolute;height:1px;background:#dce6f1;left:32px;right:12px;top:15px;transform:translateX(50%)}.steps span{width:30px;height:30px;border-radius:50%;background:#edf2f7;display:grid;place-items:center;z-index:1}.steps .current{color:#1a568f;font-weight:800}.steps .current span{background:#1476e4;color:#fff}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.form-grid label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:700;color:#536d89}.form-grid label.full{grid-column:1/-1}.form-grid textarea{min-height:100px;resize:vertical}.wizard-actions{display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #edf2f7;margin-top:25px;padding-top:18px}.review-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.review-grid div{background:#f7faff;border:1px solid #e3edf6;border-radius:9px;padding:12px}.review-grid small,.review-grid b{display:block}.review-grid small{font-size:10px;color:#8192a7;margin-bottom:4px}.review-grid b{font-size:12px}.score-preview{margin-top:18px;padding:15px;border-radius:10px;background:#f7fbff;display:flex;align-items:center;gap:18px}.score-preview span{margin-right:auto;font-size:12px}.score-preview b{font-size:24px}.assistant{min-height:620px;display:flex;flex-direction:column}.messages{flex:1;padding:10px 4px;overflow:auto}.message{display:flex;flex-direction:column;margin:12px 0;max-width:80%}.message.user{margin-left:auto;align-items:flex-end}.bubble{padding:14px 16px;border-radius:12px;background:#f1f6fb;color:#294b6e;font-size:12px;line-height:1.6}.message.user .bubble{background:#1476e4;color:#fff}.message small{font-size:9px;color:#8a9aaf;margin-top:4px}.chat-input{display:flex;gap:8px;border-top:1px solid #e8eef4;padding-top:14px}.chat-input input{flex:1}
@media(max-width:900px){.sidebar{width:72px}.brand div:last-child,.sidebar nav a:not(.active),.admin span{display:none}.sidebar nav a{justify-content:center}.main{margin-left:72px;width:calc(100% - 72px)}.stats{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}.content{padding:18px}.form-grid{grid-template-columns:1fr}.form-grid label.full{grid-column:auto}.mobile-title{display:block}.steps{gap:8px}.steps>div{font-size:10px}.big-alert{flex-wrap:wrap}.big-alert time{order:4;width:100%;padding-left:38px}.graph{height:500px}}
@media(max-width:560px){.stats{grid-template-columns:1fr}.topbar{padding:0 12px}.page-title h1{font-size:20px}.content{padding:12px}.toolbar{flex-wrap:wrap}.toolbar input{flex-basis:100%}.toolbar select{flex:1}.project-head{align-items:flex-start}.project-head>.badge{font-size:10px}.chips{flex-wrap:wrap}.big-progress{grid-template-columns:1fr}.donut-row{flex-direction:column}.node{min-width:120px;padding:8px;font-size:9px}.node b{font-size:9px}.core{width:130px}.dependency-card{padding:10px}}
/* Route Analysis */
.route-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:16px;align-items:start}.route-main{min-width:0}.route-controls{margin-bottom:12px}.route-inputs{display:grid;grid-template-columns:1fr 48px 1fr 180px;gap:10px;align-items:end}.route-inputs label{display:flex;flex-direction:column;gap:6px}.route-inputs label span{font-size:11px;font-weight:800;color:#3d5874}.route-inputs input{border:1px solid #d8e3ef;border-radius:9px;padding:12px 13px;outline:none;color:#203f61;background:#fff}.route-inputs input:focus{border-color:#2478e8;box-shadow:0 0 0 3px rgba(36,120,232,.08)}.swap{height:42px;border:1px solid #d7e3ef;background:#f8fbff;color:#1476e4;border-radius:9px;font-size:20px;font-weight:800}.analyze{height:42px}.analyze:disabled{opacity:.65;cursor:wait}.layer-checks{display:flex;flex-wrap:wrap;gap:13px;margin-top:14px;padding-top:12px;border-top:1px solid #edf2f7}.layer-checks label{display:flex;align-items:center;gap:5px;font-size:11px;color:#4e6781}.layer-checks input{accent-color:#1476e4}.route-error{margin-top:10px;padding:9px 11px;background:#fff0f1;color:#c92938;border-radius:8px;font-size:11px}.route-map-card{padding:0;overflow:hidden}.route-map-wrap{height:500px}.route-map-wrap .leaflet-container{font-family:inherit}.route-legend{position:absolute;z-index:1000;left:14px;top:14px;background:#fff;padding:10px 12px;border-radius:7px;box-shadow:0 2px 10px rgba(20,50,80,.18);display:flex;flex-direction:column;gap:7px;font-size:10px;color:#3f5873}.route-legend b{font-size:11px;color:#173e67}.route-legend span{display:flex;align-items:center;gap:7px}.route-line{display:inline-block;width:28px;height:3px}.route-line.proposed{border-top:3px dashed #e31b23}.route-line.road{background:#6f7780}.route-dot{width:10px;height:10px;border-radius:50%;display:inline-block}.route-dot.high{background:#ef3340}.route-dot.medium{background:#f4a300}.route-dot.low{background:#16a765}.route-bottom{display:grid;grid-template-columns:1fr 1.25fr;gap:16px;margin-top:16px}.cost-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #edf2f7;font-size:11px;color:#566f89}.cost-row b{color:#1e3856}.avoidable{display:flex;justify-content:space-between;gap:12px;margin-top:12px;padding:12px;border-radius:8px;background:#ffe8ea;color:#c92838;font-size:12px;font-weight:800}.avoidable b{font-size:14px}.alt-row{display:grid;grid-template-columns:75px 70px 85px 70px 1fr;align-items:center;gap:8px;padding:11px 0;border-top:1px solid #edf2f7;font-size:11px}.alt-row:first-of-type{border-top:0}.alt-row .badge{justify-self:end}.full-btn{width:100%;margin-top:12px}.route-side{display:flex;flex-direction:column;gap:16px}.route-side .card{padding:16px}.route-summary>h3,.risk-panel>h3{margin-bottom:14px}.route-summary>div:not(:first-child){display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid #edf2f7;font-size:11px}.route-summary b{font-size:12px;color:#1f3855}.route-summary b.danger{color:#e62d3d}.risk-panel{background:#fff}.route-risk{border-radius:9px;padding:14px}.route-risk strong{font-size:22px;display:block}.route-risk p{font-size:11px;line-height:1.5;margin:6px 0 0;color:#617890}.route-risk.high{background:#fff0f1;color:#df2a39}.route-risk.medium{background:#fff7e7;color:#c98700}.route-risk.low{background:#eaf9f1;color:#129157}.overlap-row{display:grid;grid-template-columns:25px 1fr auto;align-items:center;gap:8px;padding:10px 0;border-top:1px solid #edf2f7}.overlap-row>b{width:24px;height:24px;border-radius:50%;background:#f0f4f8;display:grid;place-items:center;font-size:10px}.overlap-row strong{display:block;font-size:11px;color:#294a6d}.overlap-row small{display:block;font-size:10px;color:#8192a7;margin-top:3px}.linkish{font-size:11px;color:#1476e4;font-weight:800}.distribution{display:flex;align-items:center;gap:15px}.mini-donut{width:120px;height:120px;border-radius:50%;background:conic-gradient(#2478e8 0 30%,#2ca9df 30% 50%,#f4bf21 50% 65%,#8050b7 65% 75%,#88929d 75% 100%);position:relative;flex:none}.mini-donut:after{content:"";position:absolute;inset:27px;background:#fff;border-radius:50%}.dist-list{display:flex;flex-direction:column;gap:8px;flex:1}.dist-list span{display:grid;grid-template-columns:10px 1fr auto;gap:6px;align-items:center;font-size:10px;color:#586f88}.dist-list b{color:#273f5b}.dist-dot{width:9px;height:9px;border-radius:2px;background:#2478e8}.dist-dot.water-pipeline{background:#2ca9df}.dist-dot.electricity{background:#f4bf21}.dist-dot.metro{background:#8050b7}.dist-dot.other{background:#88929d}
@media(max-width:1100px){.route-layout{grid-template-columns:1fr}.route-side{display:grid;grid-template-columns:1fr 1fr}.route-side .card:last-child{grid-column:1/-1}.route-inputs{grid-template-columns:1fr 44px 1fr 160px}}
@media(max-width:760px){.route-inputs{grid-template-columns:1fr 44px 1fr}.route-inputs .analyze{grid-column:1/-1}.route-bottom{grid-template-columns:1fr}.route-side{grid-template-columns:1fr}.route-side .card:last-child{grid-column:auto}.route-map-wrap{height:430px}.alt-row{grid-template-columns:65px 60px 70px 60px 1fr}.route-legend{font-size:9px}}
/* SIH 26103 enhancement layer */
.login-page{min-height:100vh;display:grid;grid-template-columns:1.1fr .9fr;background:linear-gradient(135deg,#032f2b,#08745f 52%,#eef8f4);font-family:inherit}
.login-visual{position:relative;overflow:hidden;color:#fff;padding:8vh 8vw;display:flex;flex-direction:column;justify-content:center;background:radial-gradient(circle at 20% 20%,rgba(45,213,140,.24),transparent 32%),linear-gradient(135deg,#063f37,#032f2b)}
.login-visual:after{content:"";position:absolute;width:520px;height:520px;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-180px;bottom:-200px;box-shadow:0 0 0 55px rgba(255,255,255,.03),0 0 0 110px rgba(255,255,255,.025)}
.login-orb{width:78px;height:78px;border:2px solid #73e17b;border-radius:50%;display:grid;place-items:center;font-size:38px;color:#73e17b;margin-bottom:24px;background:rgba(255,255,255,.05)}
.login-visual h1{font-size:42px;margin:0 0 7px}.login-visual>p{font-size:18px;opacity:.85}.login-features{display:grid;gap:12px;margin-top:35px;max-width:440px}.login-features span{padding:12px 15px;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:rgba(255,255,255,.05);font-size:13px}
.login-card{align-self:center;justify-self:center;width:min(440px,88%);background:rgba(255,255,255,.97);padding:38px;border-radius:22px;box-shadow:0 25px 70px rgba(0,0,0,.2)}
.login-card .brand.compact{display:flex;margin-bottom:26px;color:#173f6c}.login-card h2{margin:0;font-size:28px;color:#123f63}.login-card form{display:grid;gap:14px;margin-top:24px}.login-card label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:800;color:#526b84}.login-card input{box-sizing:border-box;width:100%;padding:13px 14px;border:1px solid #d6e2ec;border-radius:9px;outline:none}.login-card input:focus{border-color:#159b68;box-shadow:0 0 0 3px rgba(21,155,104,.1)}.login-submit{width:100%;margin-top:4px}.login-demo{font-size:10px;color:#71849a;background:#f4f8fb;padding:10px;border-radius:8px;margin-top:14px;line-height:1.6}.link-button{border:0;background:none;color:#1476e4;font-weight:800;cursor:pointer;margin-top:15px}.form-note{font-size:11px;padding:10px 12px;border-radius:8px}.form-note.error{background:#fff0f1;color:#c62b39}.form-note.success{background:#eaf9f1;color:#118a53}.logout-mini{margin-left:8px;border:0;background:transparent;color:#9eb0c2;font-size:10px;cursor:pointer}
.model-status{margin-left:auto;color:#138c58;font-size:11px;font-weight:800}.metric-box{display:flex;justify-content:space-between;align-items:center;padding:12px;border:1px solid #e2ebf2;background:#f8fbfd;border-radius:9px;margin-top:9px;font-size:11px;color:#587089}.metric-box b{font-size:15px;color:#183d5f}.recommendation{padding:15px;border-radius:10px;background:#eef8f4;border-left:4px solid #16a765;margin-bottom:12px}.recommendation b{font-size:14px;color:#116f4b}.recommendation p{font-size:11px;line-height:1.6;color:#526b84;margin:7px 0 0}.method-note{font-size:10px;line-height:1.55;color:#8192a7;margin-top:12px}.evm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:16px}.evm-card{background:#fff;border:1px solid #dfe9f1;border-radius:11px;padding:17px;box-shadow:0 4px 15px rgba(20,60,100,.04)}.evm-card small{display:block;color:#70859a;font-size:10px;font-weight:800}.evm-card strong{display:block;color:#153d61;font-size:22px;margin:7px 0}.evm-card span{font-size:10px;color:#ef3340}.decision-list{margin:0;padding-left:18px;color:#4e6882;font-size:12px;line-height:2}.upload-box{border:2px dashed #cfe0ec;border-radius:12px;padding:25px;text-align:center;margin:16px 0;background:#f8fbfd}.upload-box input{display:none}.upload-box label{display:block;color:#1476e4;font-weight:800;cursor:pointer}.upload-box p{font-size:10px;color:#71849a}.imagery-score{display:grid;place-items:center;padding:25px;background:#eef8f4;border-radius:12px;margin-bottom:14px}.imagery-score strong{font-size:48px;color:#138c58}.imagery-score span{font-size:11px;color:#55708a}
@media(max-width:800px){.login-page{grid-template-columns:1fr}.login-visual{display:none}.login-card{margin:30px auto}.evm-grid{grid-template-columns:1fr}.model-status{display:none}}
.alert-dot.high-risk{background:#ef3340;color:#fff}.alert-dot.medium-risk{background:#f4a300;color:#fff}.alert-dot.low-risk{background:#16a765;color:#fff}

/* SIH 26103 enhancement layer */
.login-page{min-height:100vh;background:radial-gradient(circle at 15% 20%,rgba(36,120,232,.20),transparent 35%),linear-gradient(135deg,#07111f,#0b1f32 55%,#08251e);display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:30px;padding:40px;position:relative;overflow:hidden}
.login-page:before{content:"";position:absolute;width:480px;height:480px;border:1px solid rgba(255,255,255,.08);border-radius:50%;right:-160px;top:-160px;box-shadow:0 0 0 70px rgba(255,255,255,.02),0 0 0 140px rgba(255,255,255,.015)}
.login-visual{color:#fff;max-width:650px;padding:40px 7vw;z-index:1}.login-visual h1{font-size:52px;line-height:1.02;margin:18px 0 12px;letter-spacing:-2px}.login-visual p{font-size:19px;color:#c7d5e8}.login-orb{width:72px;height:72px;border-radius:22px;display:grid;place-items:center;background:linear-gradient(135deg,#21c77a,#2478e8);font-size:32px;box-shadow:0 18px 50px rgba(0,0,0,.3)}.login-features{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:34px}.login-features span{padding:14px 16px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(255,255,255,.05);backdrop-filter:blur(10px)}
.login-card{width:min(470px,100%);background:rgba(255,255,255,.97);border:1px solid rgba(255,255,255,.45);border-radius:24px;padding:34px;box-shadow:0 30px 80px rgba(0,0,0,.35);z-index:2}.login-card h2{font-size:30px;margin:28px 0 6px}.login-card .brand.compact{display:flex;align-items:center;gap:10px;font-weight:800}.login-card .brand-mark{width:38px;height:38px}.login-submit{width:100%;height:48px;font-size:15px}.login-demo{font-size:12px;color:#6a7688;margin-top:16px;padding:12px;border-radius:10px;background:#f2f6fa}.link-button{background:none;border:0;color:#2478e8;cursor:pointer;margin-top:16px;font-weight:700}.form-note{margin:12px 0;padding:11px 12px;border-radius:10px;font-size:13px}.form-note.success{background:#eaf8f0;color:#08733d}.form-note.error{background:#fff0f0;color:#b42318}
.recommendation-card{border-left:4px solid #e05252}.warning-banner{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 17px;background:#fff5f4;border:1px solid #ffd8d4;border-radius:12px;margin:14px 0}.warning-banner b{color:#b42318}.benchmark-bars{display:grid;gap:12px}.benchmark-bars div{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;background:#f6f8fb;border-radius:10px}.benchmark-bars b{font-size:20px}.method-note{font-size:12px;line-height:1.55;color:#66758a}.model-status{font-size:12px;color:#18794e;font-weight:700}.evm-grid{grid-template-columns:repeat(3,1fr)!important}
@media(max-width:900px){.login-page{grid-template-columns:1fr;padding:22px}.login-visual{padding:15px 5px}.login-visual h1{font-size:38px}.login-features{grid-template-columns:1fr}.login-card{margin:auto}.evm-grid{grid-template-columns:repeat(2,1fr)!important}}
.selected-route-bar{display:flex;align-items:center;gap:10px;margin-top:10px;padding:12px 16px}.selected-route-bar span{font-size:12px;color:#6b7280;margin-left:auto}.alt-row{width:100%;border:0;background:transparent;cursor:pointer;text-align:left;display:grid;grid-template-columns:1fr 1fr 1fr 1fr auto;gap:8px;align-items:center;padding:12px 10px;border-radius:10px;margin-bottom:4px;font:inherit}.alt-row:hover,.alt-row.selected{background:#eef5ff}.alt-row.selected{outline:2px solid #2478e8}.route-dot.project{background:#1d6fd5}
.map-estimate-strip{position:absolute;left:12px;right:12px;bottom:12px;z-index:1000;display:grid;grid-template-columns:1.3fr repeat(5,1fr);gap:8px;padding:10px;background:rgba(255,255,255,.96);border:1px solid #dce7f0;border-radius:10px;box-shadow:0 6px 20px rgba(20,60,100,.16)}
.map-estimate-strip div{min-width:0;padding:4px 8px;border-right:1px solid #e8eef4}.map-estimate-strip div:last-child{border-right:0}.map-estimate-strip small{display:block;color:#71849a;font-size:9px;font-weight:700;text-transform:uppercase}.map-estimate-strip b{display:block;color:#173f61;font-size:12px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.map-estimate-strip .danger{color:#d92d3b}
.route-map-wrap{position:relative}
@media(max-width:900px){.map-estimate-strip{grid-template-columns:repeat(3,1fr)}.map-estimate-strip div{border-right:0}.map-estimate-strip b{font-size:10px}}
.project-analysis-overlay{position:absolute;z-index:1200;right:14px;top:14px;width:360px;max-height:calc(100% - 92px);overflow:auto;background:#fff;border:1px solid #d9e4ee;border-radius:14px;box-shadow:0 16px 45px rgba(19,55,90,.25);padding:16px}.project-analysis-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.project-analysis-head h3{margin:3px 0 4px;color:#173e67;font-size:18px}.project-analysis-head p{margin:0;color:#71849a;font-size:11px}.eyebrow{font-size:9px;font-weight:900;letter-spacing:.08em;color:#2478e8}.close-analysis{width:30px;height:30px;border:0;border-radius:8px;background:#f2f6fa;color:#536b83;font-size:20px;cursor:pointer}.analysis-source{margin:12px 0;padding:9px 10px;background:#f5f9fd;border:1px solid #e2ebf3;border-radius:9px;color:#60758c;font-size:10px;line-height:1.45}.analysis-source b{color:#284c70}.analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.analysis-grid>div,.analysis-predictions>div{padding:10px;background:#f7f9fc;border-radius:9px}.analysis-grid small,.analysis-predictions small{display:block;color:#72859a;font-size:9px;font-weight:700}.analysis-grid strong{display:block;color:#193d61;font-size:13px;margin-top:4px}.analysis-section{margin-top:14px;border-top:1px solid #edf2f7;padding-top:12px}.analysis-section h4{margin:0 0 9px;color:#294a6d;font-size:12px}.analysis-risk-row{display:flex;gap:8px;align-items:center;font-size:10px;color:#6a7d92}.analysis-risk-badge{padding:5px 8px;border-radius:999px;font-weight:900;font-size:10px}.analysis-risk-badge.high{background:#fff0f1;color:#d92d3b}.analysis-risk-badge.medium{background:#fff7e7;color:#c98700}.analysis-risk-badge.low{background:#eaf9f1;color:#129157}.analysis-predictions{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.analysis-predictions b{display:block;margin-top:4px;font-size:11px;color:#193d61}.analysis-action{margin-top:9px;padding:10px;border-radius:9px;background:#fff7e7;color:#9a6500;font-size:10px;line-height:1.45}.overlap-button{width:100%;border:0;background:transparent;text-align:left;cursor:pointer;font:inherit}.overlap-button:hover{background:#f3f7fb}.overlap-button:focus{outline:2px solid #2478e8;outline-offset:-2px}@media(max-width:760px){.project-analysis-overlay{left:10px;right:10px;width:auto;max-height:65%}}

/* Exact Map & Conflict workspace — modeled on the supplied reference UI */
.map-command-bar{padding:14px 16px;margin-bottom:14px}
.map-command-bar .route-inputs{margin:0}
.route-workspace{display:grid;grid-template-columns:minmax(0,1fr) 570px;gap:14px;align-items:stretch}
.route-map-column{min-width:0;display:flex;flex-direction:column;gap:14px}
.exact-map-card{padding:0;overflow:hidden}
.map-heading{height:54px;padding:9px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e6edf5;background:#fff}
.map-heading b{display:block;font-size:13px;color:#123d6b}
.map-heading span{display:block;font-size:10px;color:#7890a8;margin-top:3px}
.map-mode{display:flex;border:1px solid #dce6f1;border-radius:7px;overflow:hidden}
.map-mode button{border:0;background:#fff;padding:7px 14px;font-size:10px;font-weight:700;color:#617892}
.map-mode button.active{background:#1476e4;color:#fff}
.map-mode button:disabled{opacity:.65}
.exact-route-map{height:505px;margin:0;border-radius:0}
.exact-route-map .leaflet-container{border-radius:0}
.route-metrics-strip{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid #e5edf5;background:#fff}
.route-metrics-strip>div{padding:11px 13px;border-right:1px solid #edf2f7}
.route-metrics-strip>div:last-child{border-right:0}
.route-metrics-strip small{display:block;font-size:9px;color:#7b8fa5;text-transform:uppercase;letter-spacing:.3px}
.route-metrics-strip b{display:block;margin-top:4px;font-size:13px;color:#183e67}
.route-metrics-strip .danger{color:#e62d3d}
.project-detail-panel{padding:0!important;overflow:hidden;min-height:573px;box-shadow:0 4px 18px rgba(20,55,95,.08)}
.project-panel-inner{height:100%;display:flex;flex-direction:column}
.project-panel-head{padding:15px 16px 10px;display:flex;justify-content:space-between;gap:10px}
.project-title-row{display:flex;gap:10px;min-width:0}
.project-title-row h2{margin:0 0 7px;font-size:16px;color:#123d6b;line-height:1.25}
.project-hero-icon{width:38px;height:38px;border-radius:50%;background:#fff0f1;color:#ef3340;display:grid;place-items:center;font-size:20px;flex:none}
.project-chip-row{display:flex;align-items:center;gap:7px}
.project-chip-row>span:first-child{background:#e8f3ff;color:#1476e4;padding:5px 8px;border-radius:6px;font-size:10px;font-weight:800}
.close-analysis{border:0;background:none;color:#1c568e;font-size:25px;line-height:1;padding:0 3px;height:30px}
.project-meta-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 14px;padding:0 16px 10px}
.project-meta-grid div{display:grid;grid-template-columns:88px 1fr;gap:7px;font-size:10px;align-items:center}
.project-meta-grid small{color:#6f849b}.project-meta-grid b{color:#274a6f;font-size:10px;overflow-wrap:anywhere}
.status-value{color:#e52e3d!important}
.project-panel-tabs{margin:0 16px 12px;overflow:auto;white-space:nowrap}
.project-panel-tabs button{font-size:10px;padding:9px 11px}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 16px 16px;overflow:auto}
.detail-card{border:1px solid #e1eaf3;border-radius:9px;padding:12px;background:#fff;min-width:0}
.detail-card h4{margin:0 0 10px;font-size:11px;color:#174574}
.detail-card dl{gap:9px 7px}
.detail-card dt{font-size:9px}.detail-card dd{font-size:10px}
.detail-card dd em{font-size:9px}
.detail-card.full-detail{grid-column:1/-1}
.progress-circles{gap:10px}
.progress-ring{--progress:0%;width:92px;height:92px;border-radius:50%;background:conic-gradient(#1684dc var(--progress),#dcecf6 0);display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;flex:none}
.progress-ring:after{content:"";position:absolute;inset:8px;border-radius:50%;background:#fff}
.progress-ring b,.progress-ring span{position:relative;z-index:1}
.progress-ring b{font-size:15px;color:#173f68}.progress-ring span{text-align:center;font-size:8px;color:#6f849c;margin:2px 5px 0}
.data-age{font-size:9px;color:#8193a7;text-align:center;margin:7px 0 0}
.risk-detail{background:#fff7f7}
.risk-gauge{text-align:center;border-bottom:1px solid #f0e2e2;padding-bottom:7px;margin-bottom:7px}
.risk-gauge b{font-size:35px;color:#ef3340}.risk-gauge span{display:block;font-size:9px;color:#c92f3d;font-weight:700}
.risk-detail ul{padding-left:16px;margin:7px 0 0;font-size:9px;color:#5d738d;line-height:1.8}
.recommendation{background:#fff8e7;border-color:#f4e4b7}
.recommendation p{font-size:10px;line-height:1.55;color:#526b83;margin:0 0 9px}
.recommendation a{display:inline-block;background:#1476e4;color:#fff;text-decoration:none;border-radius:6px;padding:7px 10px;font-size:9px;font-weight:800}
.progress-evidence{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.progress-evidence>div{padding:12px;border:1px solid #e4ebf3;border-radius:8px;background:#fbfdff}
.progress-evidence b{display:block;font-size:18px;color:#1677d3}.progress-evidence span{display:block;font-size:9px;color:#7489a0;margin-top:4px}
.risk-analysis-big{text-align:center;border:1px solid #f0dfe1;background:#fff5f5;border-radius:9px;padding:14px}
.risk-analysis-big b{font-size:44px;color:#ef3340}.risk-analysis-big span{display:block;font-size:10px;color:#778ca2}
.prediction-row{display:flex;justify-content:space-between;border-top:1px solid #edf2f7;padding:12px 0;font-size:10px}.prediction-row b{color:#e42e3d}
.source-box{background:#f3f7fb;border:1px solid #e0e8f1;border-radius:7px;padding:9px;font-size:9px;color:#607791}
.no-project-panel{padding:22px;text-align:center;color:#59728e}
.empty-icon{width:54px;height:54px;margin:15px auto;border-radius:50%;background:#edf5ff;color:#1476e4;display:grid;place-items:center;font-size:25px}
.no-project-panel h3{font-size:14px;color:#183f68;margin:10px 0 5px}.no-project-panel>p{font-size:10px;line-height:1.55}
.route-summary-mini{text-align:left;border:1px solid #e1eaf3;border-radius:9px;margin-top:20px;padding:12px}
.route-summary-mini>b{font-size:11px;color:#174574}
.route-summary-mini div{display:flex;justify-content:space-between;border-top:1px solid #edf2f7;padding:9px 0;font-size:10px}.route-summary-mini div:first-of-type{margin-top:6px}
.route-summary-mini span{color:#71869e}.route-summary-mini strong{color:#183e67}
.route-project-strip{padding:12px;margin:0}
.strip-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.strip-title h3{margin:0;font-size:12px;color:#143f6c}.strip-title span{font-size:9px;color:#8193a7}
.project-route-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;overflow:hidden}
.route-project-card{border:1px solid #e0e9f2;background:#fff;border-radius:8px;padding:9px;text-align:left;min-width:0;transition:.15s}
.route-project-card:hover,.route-project-card.selected{border-color:#8bbff1;box-shadow:0 3px 12px rgba(20,92,155,.09)}
.rpc-top{display:flex;justify-content:space-between;align-items:center;gap:5px}
.project-type-icon{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#eaf2ff;color:#1677d3;font-size:10px;font-weight:900}
.project-type-icon.rail{background:#f0e7fb;color:#7a42b8}.project-type-icon.water{background:#e6f7ff;color:#1389c5}.project-type-icon.electric{background:#fff6dd;color:#d48b00}
.route-project-card .badge{font-size:8px;padding:3px 6px}
.route-project-card strong{display:block;font-size:10px;color:#294c70;line-height:1.35;margin-top:7px;height:27px;overflow:hidden}
.route-project-card small{display:block;font-size:8px;color:#7c90a5;margin-top:3px;height:20px;overflow:hidden}
.rpc-progress{height:5px;background:#e9eef4;border-radius:10px;overflow:hidden;margin:8px 0 5px}.rpc-progress span{display:block;height:100%;background:#2385df;border-radius:10px}
.rpc-foot{display:flex;justify-content:space-between;font-size:8px;color:#8192a6}.rpc-foot b{color:#416582}
.empty-route-projects{grid-column:1/-1;border:1px dashed #cbd9e7;border-radius:8px;padding:20px;text-align:center}.empty-route-projects b{display:block;color:#385a78;font-size:11px}.empty-route-projects span{display:block;color:#8294a7;font-size:9px;margin-top:5px}
.route-lower-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.summary-grid div{border:1px solid #e7edf4;border-radius:7px;padding:10px}.summary-grid span{display:block;font-size:9px;color:#8193a7}.summary-grid b{display:block;margin-top:4px;font-size:12px;color:#1a416a}
.route-data-note{margin-top:14px;font-size:9px;color:#71869e;line-height:1.55}
.route-data-note b{color:#365979}
@media(max-width:1250px){
 .route-workspace{grid-template-columns:minmax(0,1fr) 450px}
 .project-route-cards{grid-template-columns:repeat(2,minmax(0,1fr))}
 .detail-grid{grid-template-columns:1fr}
 .detail-card.full-detail{grid-column:auto}
 .route-metrics-strip{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:1000px){
 .route-workspace{grid-template-columns:1fr}
 .project-detail-panel{min-height:0}
 .route-metrics-strip{grid-template-columns:repeat(2,1fr)}
 .route-lower-grid{grid-template-columns:1fr}
}
@media(max-width:760px){
 .map-command-bar .route-inputs{grid-template-columns:1fr 44px 1fr}
 .map-command-bar .route-inputs .analyze{grid-column:1/-1}
 .exact-route-map{height:430px}
 .route-metrics-strip{grid-template-columns:1fr 1fr}
 .route-metrics-strip>div{border-bottom:1px solid #edf2f7}
 .project-route-cards{grid-template-columns:1fr 1fr}
 .project-meta-grid{grid-template-columns:1fr}
}
.route-data-status{display:flex;gap:12px;align-items:center;padding:10px 14px;margin-top:10px;border-radius:10px;border:1px solid #dbe4ef;font-size:12px;background:#f7fafc}.route-data-status.ok{border-color:#b9e2c5;background:#f3fbf5}.route-data-status.warning{border-color:#f0c98a;background:#fff9ed}.route-data-status b{white-space:nowrap}.route-data-status span{color:#596579}

/* Map & Conflict reference-layout refinement — scoped to this page only */
body.map-route-page{background:#f7fbff;overflow-x:hidden}
body.map-route-page .sidebar{width:253px;padding:18px 12px;background:#063566}
body.map-route-page .main{margin-left:253px;width:calc(100% - 253px)}
body.map-route-page .topbar{display:none}
body.map-route-page .content{max-width:none;padding:10px 12px 18px}
body.map-route-page .page-title{margin:0 0 8px;padding:0 1px}
body.map-route-page .page-title h1{font-size:18px;line-height:1.1}
body.map-route-page .page-title p{display:none}
body.map-route-page .map-command-bar{border:0;border-radius:0;background:transparent;box-shadow:none;padding:0;margin:0 0 8px}
body.map-route-page .map-command-bar .route-inputs{grid-template-columns:263px 40px 223px 175px;gap:8px;align-items:end;justify-content:start}
body.map-route-page .route-inputs label{gap:3px}
body.map-route-page .route-inputs label span{font-size:10px;color:#5d7893}
body.map-route-page .route-inputs input{height:40px;padding:9px 12px;border-radius:7px;font-size:11px;box-shadow:none}
