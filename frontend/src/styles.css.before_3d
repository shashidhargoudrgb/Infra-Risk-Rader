body.map-route-page .ref-card-foot{display:flex;flex-direction:column;gap:3px;font-size:7px;color:#5d7790}.ref-card-foot b{color:#1476e4}.reference-project-card .data-source-badge{display:none}
body.map-route-page .map-type-legend{left:12px;top:12px;min-width:145px;padding:10px 11px;font-size:9px}
body.map-route-page .map-layer-toggle{right:12px;top:12px}
body.map-route-page .map-scale-note{left:12px;bottom:12px}
@media(max-width:1300px){body.map-route-page .reference-map-workspace{grid-template-columns:minmax(0,1fr) 500px}.reference-route-controls{grid-template-columns:minmax(180px,1fr) 40px minmax(180px,1fr) 160px!important}.reference-project-cards{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:1050px){body.map-route-page .reference-map-workspace{grid-template-columns:1fr}.reference-detail-panel{margin-top:0!important;height:auto!important;min-height:0!important}.reference-project-cards{grid-template-columns:repeat(2,minmax(0,1fr))!important}}

.route-location-box{position:relative;min-width:0}
.location-suggestions{position:absolute;z-index:3000;left:0;right:0;top:68px;background:#fff;border:1px solid #d9e1ec;border-radius:10px;box-shadow:0 14px 30px rgba(20,35,60,.14);overflow:hidden;max-height:320px;overflow-y:auto}
.location-suggestions button{display:flex;width:100%;text-align:left;flex-direction:column;gap:3px;padding:11px 13px;border:0;border-bottom:1px solid #edf1f6;background:#fff;cursor:pointer}
.location-suggestions button:hover{background:#f5f8fc}
.location-suggestions b{font-size:13px;color:#14243a}
.location-suggestions span{font-size:12px;color:#4e6075;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.location-suggestions small{font-size:10px;color:#8794a5}
.location-searching{position:absolute;right:10px;color:#64748b}
.reference-route-controls{align-items:flex-end}
.route-alternatives{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0;padding:8px 10px;background:#f7f9fc;border:1px solid #e1e7ef;border-radius:9px;font-size:12px}
.route-alternatives button{border:1px solid #ccd6e3;background:#fff;border-radius:7px;padding:7px 10px;cursor:pointer;color:#334155}
.route-alternatives button.active{background:#0b6df0;color:#fff;border-color:#0b6df0}
.route-source-warning{margin:8px 0;padding:10px 12px;border-radius:8px;background:#fff7e6;border:1px solid #f2d28b;color:#6d4b00;font-size:12px}

.ongoing-live-badge{display:inline-flex;align-items:center;margin-left:10px;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.04em;background:#eaf7ee;color:#176b35;border:1px solid #bfe6ca}

/* Clear empty state for routes with no returned project geometry */
.empty-state-note {
  margin: 18px 0;
  padding: 14px 16px;
  border: 1px solid #dbe5f0;
  border-radius: 10px;
  background: #f7fafc;
  color: #5d6b7c;
  font-size: 12px;
  line-height: 1.55;
  text-align: left;
}
.empty-state-note b { color: #193b63; }
.retry-projects-btn { margin-top: 4px; cursor: pointer; }
.project-hero-image{display:grid;grid-template-columns:300px 1fr;gap:22px;align-items:center;margin-bottom:16px}.project-hero-image img{width:100%;height:170px;object-fit:cover;border-radius:10px;border:1px solid #dfe8f1;background:#eef5fb}.project-hero-image h3{margin:0 0 8px}.project-hero-image p{font-size:12px;line-height:1.65;color:#587089;margin:0 0 10px}.image-source-note{font-size:11px;font-weight:800;color:#138c58}.full-info-card{margin-bottom:16px}.complete-info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.complete-info-grid>div{padding:12px;border:1px solid #e2ebf2;background:#f8fbfd;border-radius:9px}.complete-info-grid small{display:block;color:#71849a;font-size:10px;font-weight:800;text-transform:none;margin-bottom:5px}.complete-info-grid b{display:block;color:#183d5f;font-size:12px;word-break:break-word}.topbar-actions{margin-left:auto;display:flex;align-items:center;gap:10px}.logout-top{border:1px solid #d9e4ed;background:#fff;color:#c62b39;border-radius:8px;padding:8px 13px;font-size:11px;font-weight:800;cursor:pointer}.logout-top:hover{background:#fff3f4}.project-image-slot img{object-fit:cover}@media(max-width:800px){.project-hero-image{grid-template-columns:1fr}.complete-info-grid{grid-template-columns:1fr}.topbar-actions .icon-btn{display:none}}

/* PAIMANA April 2026 national portfolio emphasis */
.paimana-pill{display:inline-flex;align-items:center;padding:7px 10px;border:1px solid #b9d7f5;background:#eef7ff;color:#0b5ca8;border-radius:999px;font-size:10px;font-weight:900;letter-spacing:.02em}
.paimana-hero{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:22px 24px;margin:0 0 16px;border-radius:14px;background:linear-gradient(135deg,#0b3768,#1768ad);color:#fff;box-shadow:0 8px 22px rgba(11,55,104,.16)}
.paimana-kicker{display:block;font-size:10px;font-weight:900;letter-spacing:.12em;opacity:.8;margin-bottom:4px}.paimana-hero strong{display:block;font-size:54px;line-height:1;font-weight:900}.paimana-hero>div:first-child>span:last-child{display:block;font-size:14px;font-weight:700;margin-top:5px}.paimana-hero-meta{display:flex;flex-direction:column;gap:5px;align-items:flex-end;font-size:12px}.paimana-hero-meta b{font-size:16px}.paimana-dashboard-banner{display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:16px;align-items:center;padding:16px 18px;margin-bottom:16px;border:1px solid #cfe1f3;border-radius:12px;background:#f4f9ff}.paimana-dashboard-banner>div{display:flex;flex-direction:column;gap:3px}.paimana-dashboard-banner>div:first-child{border-right:1px solid #d6e4f1;padding-right:16px}.paimana-dashboard-banner span,.paimana-dashboard-banner small{font-size:10px;color:#55718d;font-weight:800}.paimana-dashboard-banner strong{font-size:34px;line-height:1;color:#0b3768}.paimana-dashboard-banner b{font-size:18px;color:#0b3768}.source-strip{margin-top:16px;padding:12px 14px;border:1px solid #d7e4ef;border-radius:9px;background:#f7fafc;color:#597086;font-size:11px}.source-strip b{color:#244b6d}
@media(max-width:800px){.paimana-hero{flex-direction:column;align-items:flex-start}.paimana-hero-meta{align-items:flex-start}.paimana-dashboard-banner{grid-template-columns:1fr 1fr}.paimana-dashboard-banner>div:first-child{grid-column:1/-1;border-right:0;border-bottom:1px solid #d6e4f1;padding-right:0;padding-bottom:10px}.paimana-pill{display:none}}

/* Route-project evidence states: verified source markers stay visually distinct from OSM-only evidence. */
.map-project-pin.mapped { filter: grayscale(1); opacity: .9; }
.marker-key.mapped { border: 1px dashed currentColor; }
.route-project-counts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin:14px 0; }
.route-project-counts > div { padding:12px; border:1px solid rgba(148,163,184,.25); border-radius:12px; background:rgba(248,250,252,.65); }
.route-project-counts b { display:block; font-size:11px; opacity:.72; margin-bottom:4px; }
.route-project-counts strong { font-size:22px; }
@media (max-width: 720px) { .route-project-counts { grid-template-columns:1fr 1fr; } }
.live-source-diagnostics{font-size:12px;line-height:1.55}

/* Route demo fallback: simulations are intentionally distinct from real project evidence. */
body.map-route-page .reference-project-card.demo-route-project{border-style:dashed;background:#fbf9ff}
body.map-route-page .demo-project-badge{background:#eee8ff!important;color:#6339bd!important}
body.map-route-page .map-project-pin.demo{background:#7c4dff;border-color:#6339bd}.map-project-pin.demo span{color:#fff}

/* SIH26103 role/auth additions — existing UI styles remain intact */
.role-switch{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.role-switch button{border:1px solid #dbe3ee;background:#f8fafc;border-radius:10px;padding:10px;cursor:pointer;font-weight:600}
.role-switch button.active{border-color:#2478e8;background:#eef6ff}
.inline-field{display:flex;gap:8px}.inline-field input{flex:1}
.role-pill{padding:7px 10px;border-radius:999px;background:#eef6ff;font-size:12px;font-weight:700}
.toast-notification{position:fixed;right:24px;top:82px;z-index:9999;background:#fff;border:1px solid #cfe3d7;box-shadow:0 8px 24px rgba(15,23,42,.15);padding:12px 16px;border-radius:10px;font-weight:700}
.locked-action{display:inline-flex;align-items:center;gap:4px;color:#64748b;font-size:12px;font-weight:600;padding:6px 8px}
.admin-action{margin-left:6px;border:0;cursor:pointer}.danger-action{color:#b42318}
.edit-panel{margin-top:12px}.access-locked{border-left:4px solid #f4a300}
.delay-danger{font-weight:700}.on-schedule{font-weight:700}.ack-meta{display:block;margin-top:5px;color:#16a765}

/* Real-world workspace scrolling fix: map and project/details panes are independently usable. */
html,body,#root{min-height:100%}
body.map-route-page{height:100vh;overflow:hidden}
body.map-route-page .app{height:100vh;min-height:0;overflow:hidden}
body.map-route-page .main{height:100vh;min-height:0;overflow:hidden}
body.map-route-page .content{height:calc(100vh - 18px);min-height:0;overflow:auto}
body.map-route-page .reference-map-workspace{min-height:0}
body.map-route-page .reference-detail-panel{min-height:0;height:calc(100vh - 118px);overflow:hidden}
body.map-route-page .reference-detail-panel .project-panel-inner{height:100%;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
body.map-route-page .reference-detail-panel .project-panel-head,
body.map-route-page .reference-detail-panel .project-image-slot,
body.map-route-page .reference-detail-panel .project-top-meta,
body.map-route-page .reference-detail-panel .project-panel-tabs{flex-shrink:0}
body.map-route-page .reference-detail-panel .detail-grid{overflow:visible;min-height:0}
body.map-route-page .reference-project-strip{max-height:330px;overflow:auto}
body.map-route-page .reference-project-cards{overflow-y:auto;max-height:270px;padding-right:3px}
@media(max-width:1000px){
 body.map-route-page{height:auto;overflow:auto}
 body.map-route-page .app,body.map-route-page .main{height:auto;overflow:visible}
 body.map-route-page .content{height:auto;overflow:visible}
 body.map-route-page .reference-detail-panel{height:70vh;min-height:520px}
 body.map-route-page .reference-detail-panel .project-panel-inner{overflow-y:auto}
 body.map-route-page .reference-project-cards{max-height:240px}
}

/* FINAL SCROLL BEHAVIOUR FIX
   Map & Conflict should scroll as one page. The earlier 100vh + nested overflow
   rules made the map feel sticky while the right project panel scrolled separately. */
body.map-route-page,
body.map-route-page .app,
body.map-route-page .main,
body.map-route-page .content{
  height:auto !important;
  min-height:100vh;
  overflow:visible !important;
}
body.map-route-page .content{
  padding-bottom:40px;
}
body.map-route-page .reference-map-workspace{
  align-items:start;
}
body.map-route-page .reference-map-box{
  position:relative;
}
body.map-route-page .reference-detail-panel{
  height:auto !important;
  min-height:770px;
  max-height:none !important;
  overflow:visible !important;
}
body.map-route-page .reference-detail-panel .project-panel-inner{
  height:auto !important;
  max-height:none !important;
  overflow:visible !important;
}
body.map-route-page .reference-project-strip{
  max-height:none !important;
  overflow:visible !important;
}
body.map-route-page .reference-project-cards{
  max-height:none !important;
  overflow:visible !important;
}
@media(max-width:1050px){
  body.map-route-page .reference-detail-panel{min-height:0 !important;}
}


/* Project register action buttons: keep View/Edit/Delete separate and clickable. */
.project-register-actions{display:flex!important;align-items:center;justify-content:flex-start;gap:7px;flex-wrap:nowrap;min-width:215px;white-space:nowrap}
.project-register-actions .view-btn{margin:0!important;display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:7px 10px;white-space:nowrap}
table th:last-child,table td:last-child{min-width:225px}

/* Route ongoing-project cards: readable facts instead of collapsed micro-cards. */
body.map-route-page .reference-project-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;overflow:visible}
body.map-route-page .reference-project-card{min-height:215px;padding:11px;border-radius:9px}
body.map-route-page .reference-project-card strong{font-size:11px;line-height:1.35;height:auto;min-height:32px;max-height:47px;margin-top:7px}
body.map-route-page .reference-project-card small{font-size:9px;height:auto;min-height:22px;max-height:34px;margin-top:4px}
body.map-route-page .ref-source-badge{font-size:8px;line-height:1.25;min-height:20px;margin-top:7px}
body.map-route-page .ref-card-facts{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:8px;padding:7px;border:1px solid #e4ebf2;border-radius:7px;background:#f8fbfe;font-size:8px;color:#5b7187}
body.map-route-page .ref-card-facts span:last-child{grid-column:1/-1}
body.map-route-page .ref-card-facts b{color:#234d72;margin-right:3px}
body.map-route-page .ref-card-foot{font-size:8px;line-height:1.3;margin-top:7px}
body.map-route-page .paimana-route-project{border-style:dashed;background:#fffdf7}
body.map-route-page .mapped-route-project{border-style:dashed}
body.map-route-page .route-result-summary{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 10px}
body.map-route-page .route-result-summary span{padding:7px 10px;border:1px solid #dce7f1;border-radius:999px;background:#f7fafc;font-size:9px;color:#58718a}
body.map-route-page .route-result-summary b{color:#1769e0;font-size:11px}
@media(max-width:1300px){body.map-route-page .reference-project-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){body.map-route-page .reference-project-cards{grid-template-columns:1fr}.project-register-actions{flex-wrap:wrap}}

/* Always-visible navigation actions requested for the monitoring workflow. */
.sidebar{overflow:hidden}
.sidebar nav{min-height:0;overflow-y:auto;padding-right:2px}
.sidebar nav::-webkit-scrollbar{width:4px}.sidebar nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.22);border-radius:8px}
.sidebar-quick-actions{display:grid;gap:6px;margin:10px 0 8px;padding-top:10px;border-top:1px solid rgba(255,255,255,.14)}
.sidebar-quick-actions .quick-link{display:flex;align-items:center;gap:8px;padding:10px 11px;border-radius:8px;color:#eaf4ff;text-decoration:none;font-size:12px;font-weight:800;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.10)}
.sidebar-quick-actions .quick-link:hover,.sidebar-quick-actions .quick-link.active{background:#0b78e6;color:#fff;border-color:#2b91f1}
.sidebar-quick-actions .quick-link.ai{background:rgba(34,197,94,.10);border-color:rgba(125,211,154,.20)}
.sidebar-quick-actions .quick-link.ai:hover,.sidebar-quick-actions .quick-link.ai.active{background:#168a5a;border-color:#2fb979}
body.map-route-page .sidebar-quick-actions{margin-top:8px}
body.map-route-page .sidebar-quick-actions .quick-link{font-size:11px;padding:8px 10px}

/* SIH 26103 interactive decision-support layer */
.sih-command-center{border:1px solid #d6e5f3;background:linear-gradient(135deg,#f7fbff,#fff);display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center}
.sih-command-center h3{margin:4px 0 5px;color:#103f6a}.sih-command-center p{margin:0;color:#60778e;font-size:12px;max-width:760px}.sih-command-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.sih-flow{grid-column:1/-1;display:flex;align-items:center;gap:9px;flex-wrap:wrap;border-top:1px solid #e3edf6;padding-top:12px;font-size:10px;font-weight:800;color:#47637d}.sih-flow span{background:#edf5fc;border:1px solid #d9e8f4;border-radius:999px;padding:6px 9px}.sih-flow i{font-style:normal;color:#1476e4}
.route-intelligence{margin-top:12px;border:1px solid #d9e6f1;background:#fff}.ri-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;padding:14px 16px;border-bottom:1px solid #e5edf5}.ri-head h3{margin:3px 0;color:#123f68}.ri-head p{margin:0;color:#71859a;font-size:11px}.eyebrow{font-size:9px;font-weight:900;letter-spacing:.08em;color:#1476e4}.ri-tabs{display:flex;gap:4px;flex-wrap:wrap}.ri-tabs button{border:1px solid #dce7f1;background:#f7fafc;color:#45627c;padding:8px 10px;border-radius:6px;font-size:10px;font-weight:800;cursor:pointer}.ri-tabs button.active{background:#1476e4;color:#fff;border-color:#1476e4}.ri-overview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;padding:13px}.ri-kpi{border:1px solid #e1eaf2;border-radius:7px;padding:10px;min-width:0}.ri-kpi small,.simulation-result small{display:block;color:#71859a;font-size:8px;text-transform:uppercase;letter-spacing:.04em}.ri-kpi b{display:block;color:#174b75;font-size:11px;margin:5px 0;overflow:hidden;text-overflow:ellipsis}.ri-kpi span{font-size:8px;color:#71859a;line-height:1.4}.ri-empty{padding:18px;color:#6c8196;background:#f8fbfd;border:1px dashed #d6e2ec;border-radius:7px;font-size:10px;text-align:center}.dependency-flow{padding:13px}.dependency-node{display:block;width:100%;text-align:left;border:1px solid #dce7f0;background:#fff;border-radius:7px;padding:10px;cursor:pointer}.dependency-node.selected{max-width:440px;margin:auto;background:#f2f8fe;border-color:#bcd7ee;text-align:center}.dependency-node b{display:block;color:#184a72;font-size:11px;margin:3px 0}.dependency-node span{display:block;color:#71859a;font-size:8px}.dependency-node>div{display:flex;gap:5px;align-items:center}.dependency-node>div small{font-size:8px;font-weight:900;color:#60788e}.dependency-line{text-align:center;margin:10px auto;color:#1476e4;font-size:8px;font-weight:900;letter-spacing:.06em}.dependency-list{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.severity-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:4px}.severity-dot.high{background:#ef3340}.severity-dot.medium{background:#f3a400}.severity-dot.low{background:#16a765}.simulation-grid{display:grid;grid-template-columns:1fr 1.5fr;gap:12px;padding:13px}.simulation-control,.simulation-result{border:1px solid #e1eaf2;border-radius:7px;padding:13px}.simulation-control label{display:flex;justify-content:space-between;color:#3f607b;font-size:11px}.simulation-control input{width:100%;margin:20px 0}.sim-buttons{display:flex;gap:7px}.sim-buttons button{border:1px solid #d5e2ec;background:#f7fafc;border-radius:5px;padding:6px 10px;font-size:10px;font-weight:800}.simulation-control>small{display:block;color:#778b9e;font-size:8px;margin-top:10px}.simulation-result{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.simulation-result>div{background:#f8fbfd;border-radius:6px;padding:9px}.simulation-result b{display:block;color:#123f68;font-size:16px;margin-top:4px}.simulation-result p{grid-column:1/-1;font-size:9px;color:#6c8196;margin:2px 0 0}.action-center{padding:13px}.action-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #edf2f6}.action-item:last-child{border-bottom:0}.action-level{font-size:8px;font-weight:900;border-radius:4px;padding:5px 6px;min-width:48px;text-align:center;background:#fff0f1;color:#d62839}.action-level.medium{background:#fff6df;color:#9a6800}.action-level.info{background:#eaf4fd;color:#146bb2}.action-item div{flex:1}.action-item b{font-size:10px;color:#204d71}.action-item p{margin:3px 0 0;font-size:9px;color:#71859a}.action-item button{border:1px solid #d6e3ed;background:#fff;color:#176fb8;border-radius:5px;padding:6px 9px;font-size:9px;font-weight:800}.map-error-boundary,.route-map-fallback{min-height:360px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;padding:20px;text-align:center;color:#526d87;background:#f8fbfd}.route-map-fallback strong{color:#173f65}.route-map-fallback small{max-width:600px;color:#9b5360}
@media(max-width:1050px){.ri-overview-grid{grid-template-columns:repeat(2,1fr)}.dependency-list{grid-template-columns:repeat(2,1fr)}.simulation-grid{grid-template-columns:1fr}.simulation-result{grid-template-columns:repeat(2,1fr)}.sih-command-center{grid-template-columns:1fr}.sih-command-actions{justify-content:flex-start}}
@media(max-width:650px){.ri-head{flex-direction:column}.ri-overview-grid{grid-template-columns:1fr}.dependency-list{grid-template-columns:1fr}.simulation-result{grid-template-columns:1fr}.sih-flow{gap:5px}}
/* Route candidate evidence marker: visible on the map but visually distinct from verified GIS. */
body.map-route-page .map-project-pin.candidate{background:#0f9d8a;border-color:#fff;}
body.map-route-page .map-project-pin.candidate span{color:#fff;font-size:15px;}
body.map-route-page .marker-key.candidate{background:#0f9d8a;border:1px dashed #fff;}
body.map-route-page .route-project-counts strong{font-size:16px;}
