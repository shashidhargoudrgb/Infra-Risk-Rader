body.map-route-page .project-title-row{display:flex;align-items:flex-start;gap:10px;min-width:0}
body.map-route-page .project-hero-icon{width:42px;height:42px;flex:none;border-radius:50%;background:#ef3340;color:#fff;display:grid;place-items:center;font-size:18px;font-weight:900}
body.map-route-page .project-title-row h2{margin:2px 0 6px;font-size:15px;line-height:1.15;color:#123d68;max-width:390px}
body.map-route-page .project-chip-row{display:flex;gap:8px;align-items:center}
body.map-route-page .project-chip-row>span:first-child{background:#e8f3ff;color:#0b70d8;border-radius:5px;padding:4px 7px;font-size:9px;font-weight:800}
body.map-route-page .project-chip-row .badge{font-size:9px;padding:4px 7px}
body.map-route-page .close-analysis{border:0;background:transparent;color:#0b4d83;font-size:25px;line-height:1;padding:0 1px}
body.map-route-page .project-top-meta{padding:0 16px 10px;display:grid;grid-template-columns:92px 1fr;gap:5px 9px;font-size:9px;color:#526f8b}
body.map-route-page .project-top-meta>div{display:contents}
body.map-route-page .project-top-meta span{color:#67819a}
body.map-route-page .project-top-meta b{font-weight:700;color:#294e70;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
body.map-route-page .project-top-meta a{grid-column:2;color:#0b70d8;font-weight:800;text-decoration:none}
body.map-route-page .project-panel-tabs{margin:0 16px 11px;border:0;background:#eaf4fd;border-radius:6px;display:flex;gap:0;overflow:hidden}
body.map-route-page .project-panel-tabs button{flex:1;padding:9px 5px;font-size:9px;color:#174e7e;border:0;background:transparent;border-bottom:0;font-weight:700}
body.map-route-page .project-panel-tabs button.active{background:#1476e4;color:#fff;border-bottom:0;border-radius:5px}
body.map-route-page .screenshot-detail-grid{padding:0 16px 16px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
body.map-route-page .detail-card{border:1px solid #dfe8f1;border-radius:7px;padding:11px;background:#fff;min-width:0}
body.map-route-page .detail-card h4{margin:0 0 9px;color:#0f5b9a;font-size:10px}
body.map-route-page .detail-card dl{grid-template-columns:1fr 1.2fr;gap:8px 7px}
body.map-route-page .detail-card dt{font-size:8px;color:#617b94}
body.map-route-page .detail-card dd{font-size:9px;color:#294e70;line-height:1.25}
body.map-route-page .status-value{color:#ef3340!important}
body.map-route-page .progress-detail-card{min-height:174px}
body.map-route-page .progress-circles{gap:12px;justify-content:center}
body.map-route-page .progress-ring{width:92px;height:92px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:conic-gradient(#1784d8 var(--progress),#e4edf5 0);position:relative}
body.map-route-page .progress-ring:before{content:"";position:absolute;inset:8px;background:#fff;border-radius:50%}
body.map-route-page .progress-ring b,.progress-ring span{position:relative;z-index:1}
