body.map-route-page .map-type-legend span{display:flex;align-items:center;gap:7px}
body.map-route-page .marker-key{width:14px;height:14px;border-radius:50%;display:grid;place-items:center;color:#fff;font-style:normal;font-size:8px;font-weight:800;background:#f0a400}
body.map-route-page .marker-key.high{background:#ef3340}.marker-key.water{background:#2478e8}.marker-key.rail{background:#7040b4}.marker-key.other{background:#8491a2}
body.map-route-page .map-layer-toggle{position:absolute;z-index:1000;right:12px;top:12px;display:flex;overflow:hidden;border:1px solid #dce5ef;border-radius:6px;background:#fff;box-shadow:0 2px 8px rgba(20,50,80,.12)}
body.map-route-page .map-layer-toggle button{border:0;background:#fff;color:#526b86;padding:7px 13px;font-size:9px;font-weight:700}
body.map-route-page .map-layer-toggle button.active{background:#1476e4;color:#fff}
body.map-route-page .map-scale-note{position:absolute;z-index:1000;left:12px;bottom:12px;background:rgba(255,255,255,.94);padding:5px 8px;border-radius:4px;font-size:8px;color:#5d728a;box-shadow:0 1px 5px rgba(20,50,80,.12)}
body.map-route-page .map-project-icon-wrap{background:transparent;border:0}
body.map-route-page .map-project-pin{width:30px;height:30px;border-radius:50% 50% 50% 4px;transform:rotate(-45deg);display:grid;place-items:center;border:3px solid #fff;box-shadow:0 2px 7px rgba(0,0,0,.22)}
body.map-route-page .map-project-pin span{transform:rotate(45deg);color:#fff;font-size:12px;font-weight:900}
body.map-route-page .map-project-pin.road{background:#f3a400}.map-project-pin.high{background:#ef3340}.map-project-pin.water{background:#2478e8}.map-project-pin.rail{background:#7040b4}

/* Reference-like project detail panel */
body.map-route-page .project-panel-inner{height:100%;display:flex;flex-direction:column}
body.map-route-page .screenshot-head{padding:15px 16px 7px}
