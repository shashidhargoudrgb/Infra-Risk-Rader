body.map-route-page .recommendation a{display:block;background:#146fd4;color:#fff;text-decoration:none;text-align:center;border-radius:5px;padding:7px;font-size:8px;font-weight:800}
body.map-route-page .full-detail{grid-column:1/-1}
body.map-route-page .project-panel-inner>.full-detail{margin:0 16px 16px}
body.map-route-page .route-legend{display:none}

