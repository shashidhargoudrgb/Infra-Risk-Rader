/* Map overlays */
body.map-route-page .route-map-wrap{position:relative}
body.map-route-page .map-type-legend{position:absolute;z-index:1000;left:12px;top:12px;background:rgba(255,255,255,.96);border:1px solid #e3eaf2;border-radius:6px;padding:9px 11px;display:flex;flex-direction:column;gap:6px;box-shadow:0 2px 8px rgba(20,50,80,.16);font-size:9px;color:#3f5873;min-width:145px}
