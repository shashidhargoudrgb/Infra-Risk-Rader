 body.map-route-page .project-route-cards{grid-template-columns:1fr 1fr}
}

.source-chip{font-size:10px;padding:3px 7px;border:1px solid #d7dee8;border-radius:999px;background:#f7f9fc;color:#52606d;white-space:nowrap}.project-chip-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap}

/* India-wide route demo/data provenance controls */
.demo-route-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px}.demo-label{font-size:12px;font-weight:700;color:#667085}.demo-route-row button{border:1px solid #d8dee8;background:#fff;border-radius:8px;padding:6px 10px;font-size:11px;cursor:pointer}.demo-route-row button:hover{background:#f5f8fc}.source-legend{display:flex;gap:16px;flex-wrap:wrap;padding-top:9px;font-size:11px;color:#667085}.source-legend span{display:inline-flex;align-items:center;gap:5px}.source-dot{width:8px;height:8px;border-radius:50%;display:inline-block}.source-dot.verified{background:#16a765}.source-dot.demo{background:#7c4dff}.source-dot.mapped{background:#2478e8}.data-source-badge{display:inline-block;width:max-content;margin-top:5px;padding:3px 7px;border-radius:999px;font-size:9px;font-weight:800;letter-spacing:.35px}.data-source-badge.verified{background:#e7f7ef;color:#087443}.data-source-badge.demo{background:#eee8ff;color:#6339bd}.data-source-badge.mapped{background:#e8f1ff;color:#1859a9}.route-data-status.ok{display:flex;flex-direction:column;gap:2px}.route-data-status.ok b{color:#087443}.analysis-source{line-height:1.6}.analysis-source b:first-child{color:#344054}


