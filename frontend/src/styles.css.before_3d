body.map-route-page .risk-detail{background:#fff7f7;border-color:#f2d7da}
body.map-route-page .risk-factor-layout{display:grid;grid-template-columns:100px 1fr;gap:10px;align-items:center}
body.map-route-page .risk-gauge{text-align:center;border-right:1px solid #f1dadd;padding-right:8px}
body.map-route-page .risk-gauge b{display:block;font-size:34px;color:#ef3340;line-height:1}.risk-gauge span{font-size:7px;color:#788da3}.risk-gauge strong{display:block;margin-top:7px;color:#ef3340;font-size:9px}
body.map-route-page .risk-detail ul{margin:0;padding-left:14px;color:#526d87;font-size:8px;line-height:1.7}
