/* Exact reference-screen navigation: keep the Map & Conflict screen visually identical to the supplied reference. */
body.map-route-page .sidebar nav a[href="/projects"],body.map-route-page .sidebar nav a[href="/data"],body.map-route-page .sidebar nav a[href="/imagery"],body.map-route-page .sidebar nav a[href="/alerts"],body.map-route-page .sidebar nav a[href="/add"],body.map-route-page .sidebar nav a[href="/assistant"]{display:none}
